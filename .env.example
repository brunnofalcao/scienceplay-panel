# Science Play — Admin Panel
# Copie para .env.local e preencha com os valores do MESMO Supabase do SITE
# (dashboard Supabase → Settings → API, project ref wetvjyfrmnfxargsynnn).
# O painel builda sem estas chaves; sem elas, mostra estado "Supabase não configurado".

NEXT_PUBLIC_SITE_URL=https://panel.scienceplay.com
NEXT_PUBLIC_PUBLIC_SITE_URL=https://www.scienceplay.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE SERVER — nunca em componente client, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_PANEL_ENV=staging
